# Required
AWS_PROFILE=default            # local AWS credentials profile for cdk deploy
AWS_REGION=us-east-1           # Alexa+ is US-only; keep infra in us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0   # Haiku 5.5 not enabled on this account (2026-10-11)
TABLE_NAME=                    # CDK output (local dev: leave empty to use the in-memory store)
PLAN_QUEUE_URL=                # CDK output
PUBLIC_BASE_URL=               # canonical MCP server URL (CDK output)

# Optional
DEMO_HOUSEHOLD_ID=patels       # household used until account linking exists
PORT=8787

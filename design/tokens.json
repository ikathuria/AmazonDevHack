{
  "$description": "Homebase 'Dinner Departures' design tokens. Source of truth; BRAND.md references these. TV sizes are for a 1920x1080 canvas.",
  "color": {
    "bg": "#0E0F0C",
    "row": "#1A1B17",
    "flap": "#24251F",
    "paper": "#ECE6D8",
    "dim": "#8E8B80",
    "amber": "#FFB84D",
    "red": "#FF4A3D",
    "green": "#5BD18B",
    "onAccent": "#0E0F0C"
  },
  "font": {
    "display": "Archivo",
    "mono": "JetBrains Mono",
    "weight": { "regular": 500, "heavy": 800, "black": 900 }
  },
  "size": {
    "label": 24,
    "body": 32,
    "row": 40,
    "header": 64,
    "hero": 120,
    "clock": 64
  },
  "space": { "xs": 8, "sm": 16, "md": 24, "lg": 48, "xl": 88, "safeX": 88, "safeY": 64 },
  "radius": { "none": 0, "flap": 2 },
  "border": { "rule": 4 },
  "motion": {
    "flapMs": 70,
    "flapStaggerMs": 25,
    "rowSlideMs": 280,
    "tickerPxPerSec": 120,
    "easing": "cubic-bezier(.2,.8,.2,1)"
  }
}
